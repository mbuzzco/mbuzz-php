{
    "name": "mbuzz/mbuzz-php",
    "description": "Multi-touch attribution SDK for PHP - framework agnostic",
    "type": "library",
    "license": "MIT",
    "keywords": ["analytics", "attribution", "marketing", "tracking", "mbuzz"],
    "homepage": "https://mbuzz.co",
    "authors": [
        {
            "name": "Mbuzz",
            "email": "support@mbuzz.co"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^10.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "symfony/event-dispatcher": "^6.0 || ^7.0",
        "symfony/http-foundation": "^6.0 || ^7.0",
        "symfony/http-kernel": "^6.0 || ^7.0"
    },
    "suggest": {
        "symfony/http-kernel": "For Symfony framework integration (SymfonySubscriber)",
        "symfony/event-dispatcher": "For Symfony framework integration",
        "psr/http-server-middleware": "For PSR-15 framework integration (Slim, Mezzio) via Psr15Middleware"
    },
    "autoload": {
        "psr-4": {
            "Mbuzz\\": "src/Mbuzz/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mbuzz\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration"
    }
}
